<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IptvPlaylistAggregator.ArchitectureTests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ExcludeFromCodeCoverage>true</ExcludeFromCodeCoverage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="TngTech.ArchUnitNET" Version="0.13.5" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" Version="0.13.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IptvPlaylistAggregator\IptvPlaylistAggregator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ArchitectureSource Include="..\IptvPlaylistAggregator\**\*.cs" Exclude="$(DefaultItemExcludes);../IptvPlaylistAggregator/bin/**;../IptvPlaylistAggregator/obj/**">
      <ArchitectureSourceProject>IptvPlaylistAggregator</ArchitectureSourceProject>
    </ArchitectureSource>
    <ArchitectureSource Include="..\IptvPlaylistAggregator.UnitTests\**\*.cs" Exclude="$(DefaultItemExcludes);../IptvPlaylistAggregator.UnitTests/bin/**;../IptvPlaylistAggregator.UnitTests/obj/**">
      <ArchitectureSourceProject>IptvPlaylistAggregator.UnitTests</ArchitectureSourceProject>
    </ArchitectureSource>
    <ArchitectureSource Include="..\IptvPlaylistAggregator.IntegrationTests\**\*.cs" Exclude="$(DefaultItemExcludes);../IptvPlaylistAggregator.IntegrationTests/bin/**;../IptvPlaylistAggregator.IntegrationTests/obj/**">
      <ArchitectureSourceProject>IptvPlaylistAggregator.IntegrationTests</ArchitectureSourceProject>
    </ArchitectureSource>
  </ItemGroup>

  <ItemGroup>
    <ArchitectureProjectFile Include="..\IptvPlaylistAggregator\IptvPlaylistAggregator.csproj">
      <ArchitectureProjectName>IptvPlaylistAggregator</ArchitectureProjectName>
    </ArchitectureProjectFile>
    <ArchitectureProjectFile Include="..\IptvPlaylistAggregator.UnitTests\IptvPlaylistAggregator.UnitTests.csproj">
      <ArchitectureProjectName>IptvPlaylistAggregator.UnitTests</ArchitectureProjectName>
    </ArchitectureProjectFile>
    <ArchitectureProjectFile Include="..\IptvPlaylistAggregator.IntegrationTests\IptvPlaylistAggregator.IntegrationTests.csproj">
      <ArchitectureProjectName>IptvPlaylistAggregator.IntegrationTests</ArchitectureProjectName>
    </ArchitectureProjectFile>
    <ArchitectureProjectFile Include="IptvPlaylistAggregator.ArchitectureTests.csproj">
      <ArchitectureProjectName>IptvPlaylistAggregator.ArchitectureTests</ArchitectureProjectName>
    </ArchitectureProjectFile>
    <ArchitectureSolutionFile Include="..\IptvPlaylistAggregator.slnx" />
  </ItemGroup>

  <Target Name="CopyArchitectureSources" AfterTargets="Build">
    <PropertyGroup>
      <ArchitectureSourcesDirectory>$(TargetDir)ArchitectureSources</ArchitectureSourcesDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(ArchitectureSourcesDirectory)" />
    <Copy SourceFiles="@(ArchitectureSource)" DestinationFiles="@(ArchitectureSource->'$(ArchitectureSourcesDirectory)/%(ArchitectureSourceProject)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ArchitectureProjectFile)" DestinationFiles="@(ArchitectureProjectFile->'$(ArchitectureSourcesDirectory)/Projects/%(ArchitectureProjectName).csproj')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ArchitectureSolutionFile)" DestinationFiles="@(ArchitectureSolutionFile->'$(ArchitectureSourcesDirectory)/Projects/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
